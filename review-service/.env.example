PORT=5001
NODE_ENV=development

# Supabase Postgres — same project as the main app is fine (separate table,
# separate schema file, separate Prisma client — no shared code or FKs).
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# MUST be the exact same value as the main backend's JWT_SECRET — this
# service verifies tokens issued by the main app's /api/auth/login, it
# does not issue its own.
JWT_SECRET=replace-with-a-long-random-value

CORS_ORIGIN=http://localhost:5173
