{
  "version": 2,
  "builds": [
    {
      "src": "src/server.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/sync-product-ratings.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/sync-product-ratings",
      "dest": "/api/sync-product-ratings.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/src/server.ts"
    }
  ],
  "crons": [
    {
      "path": "/api/sync-product-ratings",
      "schedule": "0 3 * * *"
    }
  ]
}
