PORT=5000
NODE_ENV=development

# Supabase Postgres — pooled connection (pgbouncer, port 6543), used by the running app
DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:6543/postgres?pgbouncer=true
# Supabase Postgres — direct connection (port 5432), used only by `prisma migrate`
DIRECT_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

JWT_SECRET=replace-with-a-long-random-value
CORS_ORIGIN=http://localhost:5173

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Used by api/sync-product-ratings.ts (the serverless function) to reach
# the independently-deployed review service, and to let non-cron callers
# authenticate against that function.
REVIEW_SERVICE_URL=https://your-review-service.vercel.app
CRON_SECRET=replace-with-a-long-random-value
